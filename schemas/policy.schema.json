{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-surface-map.local/schemas/policy.schema.json",
  "title": "Agent Surface Map Policy",
  "type": "object",
  "properties": {
    "max_risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "max_risk_delta": { "type": "integer", "minimum": 0, "maximum": 100 },
    "block_severities": { "$ref": "#/$defs/stringList" },
    "review_severities": { "$ref": "#/$defs/stringList" },
    "block_capabilities": { "$ref": "#/$defs/stringList" },
    "review_capabilities": { "$ref": "#/$defs/stringList" },
    "allowed_mcp_server_names": { "$ref": "#/$defs/stringList" },
    "denied_mcp_server_names": { "$ref": "#/$defs/stringList" },
    "allowed_paths": { "$ref": "#/$defs/stringList" },
    "denied_paths": { "$ref": "#/$defs/stringList" },
    "blocked_paths": { "$ref": "#/$defs/stringList" },
    "allowed_browser_profiles": { "$ref": "#/$defs/stringList" },
    "required_approvals": { "$ref": "#/$defs/stringList" }
  },
  "additionalProperties": true,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
